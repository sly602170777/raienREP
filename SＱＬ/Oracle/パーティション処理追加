修正版：C#+Oracle 多表 日時分区 批量清理バッチ（直接運用可）

核心改修点

✅  複数テーブル対応（任意追加可）
✅  共通日時分区ルール統一適用
✅  テーブル別処理ログ詳細化
✅  個別テーブルエラー非影響他テーブル（続行処理）

事前前提（同前）

• Oracle分区タイプ：範囲パーティション（日付/年月基準）

• 分区命名規則：P+年月（例P202401，必須統一，SQLで日付抽出可能）

• 権限：ALTER TABLE + DROP TABLESPACE 権限

• 環境：.NET6+、Oracle.ManagedDataAccess.Core（NuGetインストール）
一、 修正後C#完全コード（多表対応版）
using Oracle.ManagedDataAccess.Client;
using System;
using System.Collections.Generic;
using System.IO;

namespace OracleMultiTablePartitionClean
{
    class Program
    {
        // 1. DB接続情報（日本環境用、自身の情報に置き換え）
        private const string DB_CONN_STR = "Data Source=(DESCRIPTION=(ADDRESS_LIST=(ADDRESS=(PROTOCOL=TCP)(HOST=DBサーバIP)(PORT=1521)))(CONNECT_DATA=(SERVICE_NAME=ORCL)));User Id=ユーザ名;Password=パスワード;";
        // 2. 共通設定：データ保留月数（全テーブル共通/個別設定可）
        private const int RETAIN_MONTHS = 18;
        // 3. 対象テーブルリスト【追加・削除自由】（表名 + 分区キーカラム名）
        private static readonly List<(string TableName, string DatePartitionCol)> TargetTables = new()
        {
            ("T_SALES", "SALES_DATE"),    // 売上表：分区キー=売上日
            ("T_ORDER", "ORDER_DATE"),    // 受注表：分区キー=受注日
            ("T_LOG_ACCESS", "LOG_DATE")  // アクセスログ表：分区キー=ログ日
        };
        // ログ保存パス
        private static readonly string LOG_PATH = $"MultiTable_PartClean_{DateTime.Now:yyyyMMdd}.log";

        static void Main(string[] args)
        {
            WriteLog("===== 【多表】パーティション削除バッチ 開始 =====");
            try
            {
                using (var conn = new OracleConnection(DB_CONN_STR))
                {
                    conn.Open();
                    WriteLog("✅ DB接続成功");

                    // 4. 対象テーブルをループ処理（1テーブルエラーでも他続行）
                    foreach (var (tableName, dateCol) in TargetTables)
                    {
                        WriteLog($"【対象テーブル】{tableName}（分区キー：{dateCol}）処理開始");
                        try
                        {
                            // ステップ1：当該テーブルの不要分区を取得
                            var expiredPartitions = GetExpiredPartitions(conn, tableName, dateCol);
                            if (expiredPartitions.Count == 0)
                            {
                                WriteLog($"⚠️  {tableName} 削除対象分区なし");
                                continue;
                            }

                            // ステップ2：不要分区を批量DROP（高速削除）
                            foreach (var partName in expiredPartitions)
                            {
                                DropPartition(conn, tableName, partName);
                                WriteLog($"✅ {tableName} - 分区削除成功：{partName}");
                            }
                            WriteLog($"✅ {tableName} 処理完了\n");
                        }
                        catch (Exception ex)
                        {
                            WriteLog($"❌ {tableName} 処理失敗：{ex.Message}\n");
                            continue; // 他テーブル処理を続行
                        }
                    }
                }
                WriteLog("===== 【多表】パーティション削除バッチ 正常終了 =====");
            }
            catch (Exception ex)
            {
                WriteLog($"===== バッチ全体致命的エラー：{ex.Message} =====");
                throw;
            }
        }

        /// <summary>保留期間超過の分区名を取得（多表対応版）</summary>
        private static List<string> GetExpiredPartitions(OracleConnection conn, string tableName, string dateCol)
        {
            var partitions = new List<string>();
            // 分区名(P202401)から年月抽出 → 保留期間判定
            var sql = $@"
                SELECT PARTITION_NAME
                FROM USER_TAB_PARTITIONS
                WHERE TABLE_NAME = UPPER('{tableName}')
                  AND TO_DATE(SUBSTR(PARTITION_NAME, 2, 6), 'YYYYMM') < ADD_MONTHS(SYSDATE, -{RETAIN_MONTHS})
                ORDER BY PARTITION_NAME";
            using (var cmd = new OracleCommand(sql, conn))
            using (var reader = cmd.ExecuteReader())
            {
                while (reader.Read()) partitions.Add(reader.GetString(0));
            }
            return partitions;
        }

        /// <summary>分区削除（ALTER TABLE DROP PARTITION：高速・推奨）</summary>
        private static void DropPartition(OracleConnection conn, string tableName, string partName)
        {
            // オプション：PURGEで即時解放（空き領域を直ちに戻す、推奨）
            var sql = $@"ALTER TABLE {tableName} DROP PARTITION {partName} PURGE";
            using (var cmd = new OracleCommand(sql, conn))
            {
                cmd.ExecuteNonQuery();
            }
        }

        /// <summary>共通ログ出力（コンソール+ファイル両方）</summary>
        private static void WriteLog(string message)
        {
            var logLine = $"{DateTime.Now:yyyy-MM-dd HH:mm:ss} | {message}";
            Console.WriteLine(logLine);
            File.AppendAllText(LOG_PATH, logLine + Environment.NewLine);
        }
    }
}
