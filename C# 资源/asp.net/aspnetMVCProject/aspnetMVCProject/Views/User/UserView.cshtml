        // 调用 AJAX 请求获取 JSON 数据
        $.getJSON("/User/GetUsers", function (data) {
            //data = JSON.parse(data);
            if (data['success']) {
                // 动态渲染 JSON 数据到表格
                data['users'].forEach(function (user) {
                    $("#usersTable tbody").append(`
